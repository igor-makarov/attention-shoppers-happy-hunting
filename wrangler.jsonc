{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attention-shoppers-happy-hunting",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  }
}
