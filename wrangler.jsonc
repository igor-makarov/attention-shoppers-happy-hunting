{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "attention-shoppers-happy-hunting",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "BoardStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardStore"] }
  ],
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
