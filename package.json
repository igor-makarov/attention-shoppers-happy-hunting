{
  "name": "attention-shoppers-happy-hunting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev --port 8789",
    "test": "node --test tests/*.test.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "verify": "npm test && npm run build",
    "cron:local": "node scripts/simulate-cron.mjs",
    "cron:offline": "node scripts/simulate-cron.mjs --offline",
    "check:sources": "node scripts/check-sources.mjs",
    "probe:production": "node scripts/probe-production.mjs",
    "qa:browser": "node scripts/browser-qa.mjs"
  },
  "devDependencies": { "wrangler": "4.149.0" }
}
